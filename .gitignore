# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local secrets
.env
.env.*
kaggle.json
~/.kaggle/

# Data — ignore contents but keep folders
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained model artifacts (root-level only; src/qml_healthcare/models/ is source code)
/models/
*.pkl
*.joblib
src/*.egg-info/

# Experiment tracking
mlruns/
wandb/

# OS
.DS_Store
Thumbs.db

# Local tooling state
.claude/
reports/pipeline_run.log

# Figures that only the notebooks write (not produced by the pipeline, not committed)
reports/figures/feature_map_*.png
reports/figures/correlation_heatmap.png
reports/figures/feature_distributions.png
reports/figures/missingness.png

# Docs site build + generated assets (regenerated by scripts/sync_docs_assets.py)
site/
docs/assets/figures/
docs/assets/data/*.json
